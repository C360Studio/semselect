{
  "namespace": "semselectsynth",
  "sources": [
    {
      "type": "docs",
      "paths": [
        "/corpus"
      ],
      "watch": false
    }
  ],
  "source_roots": [
    "/corpus"
  ],
  "graph": {
    "embedder_type": "http",
    "index_workers": 4,
    "coalesce_ms": 200,
    "enable_clustering": true,
    "clustering_llm": true,
    "entity_id_edges": {
      "include_system_peers": false
    },
    "gateway_bind": "127.0.0.1:8082",
    "enable_playground": false
  },
  "model_registry": {
    "endpoints": {
      "semembed": {
        "provider": "openai",
        "url": "http://semembed:8081/v1",
        "model": "Snowflake/snowflake-arctic-embed-s",
        "query_prefix": "Represent this sentence for searching relevant passages: "
      },
      "seminstruct": {
        "provider": "openai",
        "url": "http://seminstruct:8083/v1",
        "model": "seminstruct",
        "max_tokens": 16384
      }
    },
    "capabilities": {
      "embedding": {
        "preferred": [
          "semembed"
        ]
      },
      "community_summary": {
        "preferred": [
          "seminstruct"
        ]
      },
      "query_classification": {
        "preferred": [
          "seminstruct"
        ]
      },
      "answer_synthesis": {
        "preferred": [
          "seminstruct"
        ]
      }
    }
  },
  "workspace_dir": "/tmp/workspace",
  "http_port": 8080,
  "websocket_bind": "127.0.0.1:7890",
  "metrics": {
    "port": 9091
  }
}
